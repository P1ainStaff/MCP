{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "inlineSources": false,
    "removeComments": true,
    "declaration": true,
    "declarationMap": false,
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "module": "NodeNext",
    "target": "ESNext",
    "strict": true,
    "lib": ["es2018", "esnext"]
  },
  "include": ["src/**/*.mts"],
  "exclude": ["node_modules", "dist", "src/__tests__/**/*", "src/**/*.spec.mts"]
}
